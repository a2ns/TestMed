# PostgreSQL (serveur cabinet)
DATABASE_URL=postgresql://magicmed:magicmed@localhost:5432/magicmed

# Assistant IA (API compatible OpenAI : Mistral, OpenAI, ou Ollama local)
# Ollama local : AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
AI_API_KEY=

# Clé maîtresse de chiffrement des données sensibles (NIR). OBLIGATOIRE en production.
# Générer : openssl rand -base64 32
MAGICMED_CLE_MASTER=

# Sauvegardes chiffrées
MAGICMED_SAUVEGARDE_DOSSIER=/var/backups/magicmed
MAGICMED_SAUVEGARDE_RETENTION=30

# Sesam-Vitale (poste Windows de facturation, phase 2)
# FSV_DLL=C:\\Program Files\\FSV\\sgpv.dll

# DMP / téléservices (phase 3, après habilitation)
# DMP_URL=https://dmp.example/soap/services/
# DMP_CERTIFICAT=/etc/magicmed/cert-p12.p12
