model Ordonnance {
  id            String         @id @default(uuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  praticienId   String?
  type          OrdoType       @default(SIMPLE)
  securisee     Boolean        @default(false)
  date          DateTime       @default(now())
  prescriptions Prescription[]

  @@index([patientId, date])
}

model Prescription {
  id              String     @id @default(uuid())
  ordonnanceId    String
  ordonnance      Ordonnance @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade)
  zone            String     @default("A") // A | B (bi-ordonnance)
  medicament      String
  cip             String?
  posologie       String
  duree           String?
  dureeJours      Int?
  substitution    Boolean    @default(false)
  renouvellements Int        @default(0)
  position        Int        @default(0)
}

model RendezVous {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  praticienId String?
  debut       DateTime
  dureeMin    Int      @default(20)
  statut      String   @default("PLANIFIE") // PLANIFIE | ARRIVE | HONORE | ANNULE
  motif       String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([debut])
  @@index([patientId])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  ts        DateTime @default(now())
  userId    String
  action    String
  cibleType String?
  cibleId   String?
  detail    Json?
}

model Correspondant {
  id        String   @id @default(uuid())
  nom       String
  specialite String?
  adresse   String?
  email     String?
  telephone String?
  createdAt DateTime @default(now())
  @@unique([nom, specialite])
}

model ConstanteBio {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String   // POIDS | TENSION_SYST | TENSION_DIAST | GLYCEMIE | ...
  valeur    String
  unite     String?
  date      DateTime @default(now())
  @@index([patientId, date])
}
