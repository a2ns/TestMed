generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEDECIN
  SECRETAIRE
  ADMIN
}

enum OrdoType {
  SIMPLE
  BI_ORDONNANCE
  SECURISEE
}

enum DocType {
  COURRIER
  COMPTE_RENDU
  ORDONNANCE
  RESULTAT_EXAMEN
  IMAGERIE
  CERTIFICAT
  FACTURE
  AUTRE
}

model Praticien {
  id             String   @id @default(uuid())
  identifiant    String?  @unique
  motDePasse     String?
  nom            String
  prenoms        String
  rpps           String?  @unique
  adeli          String?
  specialite     String?
  roles          Role[]
  cabinetNom     String?
  cabinetAdresse String?
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
}

