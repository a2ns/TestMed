model Traitement {
  id         String    @id @default(uuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicament String
  posologie  String
  duree      String?
  actif      Boolean   @default(true)
  dateDebut  DateTime  @default(now())
  dateFin    DateTime?

  @@index([patientId])
}

model Allergie {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance String
  gravite   String // FAIBLE | MODEREE | SEVERE
  reactions String?
  createdAt DateTime @default(now())

  @@index([patientId])
}

model Consultation {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  praticienId String?
  motif       String?
  notes       String?
  date        DateTime @default(now())

  @@index([patientId, date])
}

model Document {
  id             String                   @id @default(uuid())
  patientId      String?
  patient        Patient?                 @relation(fields: [patientId], references: [id], onDelete: SetNull)
  nomFichier     String
  cheminStockage String
  type           DocType                  @default(AUTRE)
  ocrTexte       String?
  tsv            Unsupported("tsvector")?
  scanOrigine    String?
  aTrier         Boolean @default(false) // caddie : en attente de rattachement patient
  nbPages        Int                      @default(1)
  version        Int                      @default(1)
  motsCles       String[]
  createdAt      DateTime                 @default(now())
  createdBy      String?

  @@index([patientId])
  @@index([type])
}

model GabaritCourrier {
  id        String     @id @default(uuid())
  code      String     @unique
  libelle   String
  contenu   String
  type      DocType    @default(COURRIER)
  courriers Courrier[]
}

